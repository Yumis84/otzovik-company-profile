torage.filename(name text)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\nAS $function$\nDECLARE\n    _parts text[];\nBEGIN\n    SELECT string_to_array(name, '/') INTO _parts;\n    RETURN _parts[array_length(_parts, 1)];\nEND\n$function$\n"},{"args":"text","name":"extension","schema":"storage","identity":"name text","definition":"CREATE OR REPLACE FUNCTION storage.extension(name text)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\nAS $function$\nDECLARE\n    _parts text[];\n    _filename text;\nBEGIN\n    -- Split on \"/\" to get path segments\n    SELECT string_to_array(name, '/') INTO _parts;\n    -- Get the last path segment (the actual filename)\n    SELECT _parts[array_length(_parts, 1)] INTO _filename;\n    -- Extract extension: reverse, split on '.', then reverse again\n    RETURN reverse(split_part(reverse(_filename), '.', 1));\nEND\n$function$\n"},{"args":"","name":"operation","schema":"storage","identity":"","definition":"CREATE OR REPLACE FUNCTION storage.operation()\n RETURNS text\n LANGUAGE plpgsql\n STABLE\nAS $function$\nBEGIN\n    RETURN current_setting('storage.operation', true);\nEND;\n$function$\n"},{"args":"text[]","name":"allow_any_operation","schema":"storage","identity":"expected_operations text[]","definition":"CREATE OR REPLACE FUNCTION storage.allow_any_operation(expected_operations text[])\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\n  WITH current_operation AS (\n    SELECT storage.operation() AS raw_operation\n  ),\n  normalized AS (\n    SELECT CASE\n      WHEN raw_operation LIKE 'storage.%' THEN substr(raw_operation, 9)\n      ELSE raw_operation\n    END AS current_operation\n    FROM current_operation\n  )\n  SELECT EXISTS (\n    SELECT 1\n    FROM normalized n\n    CROSS JOIN LATERAL unnest(expected_operations) AS expected_operation\n    WHERE expected_operation IS NOT NULL\n      AND expected_operation <> ''\n      AND n.current_operation = CASE\n        WHEN expected_operation LIKE 'storage.%' THEN substr(expected_operation, 9)\n        ELSE expected_operation\n      END\n  );\n$function$\n"}],"sequences":[{"cycle":false,"data_type":"bigint","max_value":9223372036854776000,"min_value":1,"cache_size":1,"last_value":8,"schemaname":"public","start_value":1,"increment_by":1,"sequencename":"audit_log_id_seq","sequenceowner":"postgres"}],"schema_acl":[{"acl":"{postgres=UC/postgres,anon=U/postgres,authenticated=U/postgres,service_role=U/postgres,dashboard_user=UC/postgres}","name":"extensions"},{"acl":"{supabase_admin=UC/supabase_admin,anon=U/supabase_admin,authenticated=U/supabase_admin,service_role=U/supabase_admin,supabase_auth_admin=UC/supabase_admin,dashboard_user=UC/supabase_admin,postgres=U/supabase_admin}","name":"auth"},{"acl":"{postgres=UC/postgres,anon=U/postgres,authenticated=U/postgres}","name":"media_internal"},{"acl":"{pg_database_owner=UC/pg_database_owner,=U/pg_database_owner,postgres=U/pg_database_owner,anon=U/pg_database_owner,authenticated=U/pg_database_owner,service_role=U/pg_database_owner,specialist_operator=U/pg_database_owner}","name":"public"},{"acl":"{supabase_admin=UC/supabase_admin,postgres=U*/supabase_admin,anon=U/supabase_admin,authenticated=U/supabase_admin,service_role=U/supabase_admin,supabase_storage_admin=U*C*/supabase_admin,dashboard_user=UC/supabase_admin,specialist_operator=U/postgres}","name":"storage"}]},"policies":[{"cmd":"SELECT","qual":"((bucket_id = 'company-media'::text) AND storage.allow_any_operation(ARRAY['object.get_authenticated_info'::text, 'object.get_authenticated'::text]) AND media_internal.is_published_company_media_object(name))","roles":["anon"],"tablename":"objects","permissive":"PERMISSIVE","policyname":"anon_read_published_company_media","schemaname":"storage","with_check":null},{"cmd":"DELETE","qual":"((bucket_id = 'company-media'::text) AND ((storage.foldername(name))[1] IN ( SELECT (company_memberships.company_id)::text AS company_id\n   FROM company_memberships\n  WHERE ((company_memberships.user_id = ( SELECT auth.uid() A