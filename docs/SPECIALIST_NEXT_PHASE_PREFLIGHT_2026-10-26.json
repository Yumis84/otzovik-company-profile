  "constraints": [
    {
      "conname": "specialist_profiles_slug_key",
      "definition": "UNIQUE (slug)",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_owner_user_id_fkey",
      "definition": "FOREIGN KEY (owner_user_id) REFERENCES auth.users(id) ON DELETE CASCADE",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_settings_email_check",
      "definition": "CHECK ((char_length(email) <= 320))",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_contact_channels_specialist_id_sort_order_key",
      "definition": "UNIQUE (specialist_id, sort_order)",
      "table_name": "specialist_contact_channels"
    },
    {
      "conname": "specialist_settings_phone_check",
      "definition": "CHECK ((char_length(phone) <= 100))",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_profiles_profession_check",
      "definition": "CHECK (((char_length(btrim(profession)) >= 1) AND (char_length(btrim(profession)) <= 120)))",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_specialization_check",
      "definition": "CHECK ((char_length(specialization) <= 160))",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_city_check",
      "definition": "CHECK ((char_length(city) <= 120))",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_description_check",
      "definition": "CHECK ((char_length(description) <= 2000))",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_slug_format",
      "definition": "CHECK (((slug ~ '^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$'::text) AND (slug !~ '^xn--'::text) AND (slug <> ALL (ARRAY['www'::text, 'api'::text, 'admin'::text, 'test'::text, 'test2'::text, 'account'::text, 'login'::text, 'profiles'::text, 'specialists'::text]))))",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_name_length",
      "definition": "CHECK (((char_length(btrim(display_name)) >= 2) AND (char_length(btrim(display_name)) <= 150)))",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_status_check",
      "definition": "CHECK ((profile_status = 'draft'::text))",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_profiles_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "specialist_profiles"
    },
    {
      "conname": "specialist_services_name_check",
      "definition": "CHECK (((char_length(btrim(name)) >= 2) AND (char_length(btrim(name)) <= 150)))",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_services_description_check",
      "definition": "CHECK ((char_length(description) <= 2000))",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_services_price_from_check",
      "definition": "CHECK (((price_from >= (0)::numeric) AND (price_from <= (100000000)::numeric)))",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_services_check",
      "definition": "CHECK ((((price_to >= (0)::numeric) AND (price_to <= (100000000)::numeric)) AND ((price_from IS NULL) OR (price_to >= price_from))))",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_services_currency_check",
      "definition": "CHECK ((currency = ANY (ARRAY['RUB'::text, 'USD'::text, 'EUR'::text])))",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_services_duration_minutes_check",
      "definition": "CHECK (((duration_minutes >= 1) AND (duration_minutes <= 1440)))",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_services_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_services_specialist_id_fkey",
      "definition": "FOREIGN KEY (specialist_id) REFERENCES specialist_profiles(id) ON DELETE CASCADE",
      "table_name": "specialist_services"
    },
    {
      "conname": "specialist_settings_website_check",
      "definition": "CHECK (((char_length(website) <= 500) AND (website ~ '^https://[^[:space:]]+$'::text)))",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_settings_work_formats_check",
      "definition": "CHECK (((work_formats <@ ARRAY['online'::text, 'studio'::text, 'onsite'::text]) AND (array_position(work_formats, NULL::text) IS NULL)))",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_settings_service_area_check",
      "definition": "CHECK ((char_length(service_area) <= 300))",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_settings_qualifications_check",
      "definition": "CHECK ((char_length(qualifications) <= 2000))",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_settings_contact_visibility_check",
      "definition": "CHECK ((contact_visibility = 'private'::text))",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_settings_pkey",
      "definition": "PRIMARY KEY (specialist_id)",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_settings_specialist_id_fkey",
      "definition": "FOREIGN KEY (specialist_id) REFERENCES specialist_profiles(id) ON DELETE CASCADE",
      "table_name": "specialist_settings"
    },
    {
      "conname": "specialist_media_kind_check",
      "definition": "CHECK ((kind = ANY (ARRAY['avatar'::text, 'portfolio'::text])))",
      "table_name": "specialist_media"
    },
    {
      "conname": "specialist_media_caption_check",
      "definition": "CHECK ((char_length(caption) <= 500))",
      "table_name": "specialist_media"
    },
    {
      "conname": "specialist_contact_channels_sort_order_check",
      "definition": "CHECK (((sort_order >= 0) AND (sort_order <= 19)))",
      "table_name": "specialist_contact_channels"
    },
    {
      "conname": "specialist_media_check",
      "definition": "CHECK ((object_name ~~ ((((specialist_id)::text || '/'::text) || kind) || '/%'::text)))",
      "table_name": "specialist_media"
    },
    {
      "conname": "specialist_media_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "specialist_media"
    },
    {
      "conname": "specialist_media_object_name_key",
