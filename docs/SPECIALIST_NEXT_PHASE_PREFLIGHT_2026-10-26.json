    },
    {
      "conname": "specialist_media_specialist_id_fkey",
      "definition": "FOREIGN KEY (specialist_id) REFERENCES specialist_profiles(id) ON DELETE CASCADE",
      "table_name": "specialist_media"
    },
    {
      "conname": "specialist_channel_sets_version_check",
      "definition": "CHECK ((version > 0))",
      "table_name": "specialist_channel_sets"
    },
    {
      "conname": "specialist_channel_sets_pkey",
      "definition": "PRIMARY KEY (specialist_id)",
      "table_name": "specialist_channel_sets"
    },
    {
      "conname": "specialist_channel_sets_specialist_id_fkey",
      "definition": "FOREIGN KEY (specialist_id) REFERENCES specialist_profiles(id) ON DELETE CASCADE",
      "table_name": "specialist_channel_sets"
    },
    {
      "conname": "specialist_contact_channels_kind_check",
      "definition": "CHECK ((kind = ANY (ARRAY['telegram'::text, 'max'::text, 'vk'::text, 'whatsapp'::text, 'ok'::text, 'website'::text, 'portfolio'::text])))",
      "table_name": "specialist_contact_channels"
    },
    {
      "conname": "specialist_contact_channels_value_raw_check",
